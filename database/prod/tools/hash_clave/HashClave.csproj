<Project Sdk="Microsoft.NET.Sdk">

  <!-- Piloto PROD — corrección 2a: genera el hash BCrypt de la clave inicial
       del primer administrador. Misma librería y versión que el backend. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hash_clave</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

</Project>
